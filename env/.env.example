# --- Российская часть
# Домен российского сервера, должен вести через DNS на соответствующий сервер
RU_SERVER_DOMAIN="<домен-российского-сервера>"

# Порт для подключения к ssh российского сервера. На голом сервере - 22
RU_SERVER_SSH_PORT: "22"
# Если нужно изменить порт с дефолнтого (RU_SERVER_SSH_PORT) на другой - указать нужный
# После смены не обязательно переносить его в RU_SERVER_SSH_PORT - при запуске происходит выбор доступного из двух
# Если после смены надо поменять еще раз, тогда нужно перенести значение в RU_SERVER_SSH_PORT, а тут указать новое
# По умолчанию при сетапе сервера поменяет на 2922
RU_SERVER_NEW_SSH_PORT: "2922"
# Пользователь, под которым ansible авторизуется на сервере. Должен иметь привилегии для входа под root (sudo)
RU_SERVER_USER="root"

# password - если авторизация на сервер по паролю (+заполнить RU_SERVER_PASSWORD)
# ssh - если авторизация на сервер по ssh-ключу (+заполнить RU_SERVER_SSH_FILE_NAME)
RU_SERVER_AUTH_METHOD="password"
# Пароль, под которым ansible авторизуется на сервере. Должен иметь привилегии для входа под root (sudo)
# Нужно либо заполнить, либо изменить RU_SERVER_AUTH_METHOD
RU_SERVER_PASSWORD="<пароль_от_RU_SERVER_USER>"
# Если вход на сервер по ssh ключу, положи в папку ssh свой приватный ключ, укажи тут название (только название) файла и поставь RU_SERVER_AUTH_METHOD="ssh"
RU_SERVER_SSH_FILE_NAME="<название_файла_с_ssh_ключом>"

# Если RU_SERVER_USER - не root: поставить RU_SERVER_BECOME="1", заполнить RU_SERVER_BECOME_PASSWORD
# После входа на сервер под RU_SERVER_USER ansible попытается стать RU_SERVER_BECOME_USER
RU_SERVER_BECOME="0"
RU_SERVER_BECOME_USER="root"
# Пароль, запрашиваемый при sudo для пользователя RU_SERVER_USER
# Если вход на сервер под пользователем RU_SERVER_USER по паролю, то как правило RU_SERVER_BECOME_PASSWORD="${RU_SERVER_PASSWORD}"
RU_SERVER_BECOME_PASSWORD="${RU_SERVER_PASSWORD}"

# Токен телеграм-бота для 3x-ui панели, установенной на российском сервере
RU_SERVER_3X_TG_BOT_TOKEN: ""
# ID чата (пользователя) админа телеграм-бота для панели, установенной на российском сервере
# Смотрим свой id через @username_to_id_bot
RU_SERVER_3X_TG_BOT_CHAT_ID: "0"
# ---

# --- Зарубежная часть
# Домен зарубежного сервера, должен вести через DNS на соответствующий сервер
WORLD_SERVER_DOMAIN="<домен-зарубежного-сервера>"

# Порт для подключения к ssh зарубежного сервера. На голом сервере - 22
WORLD_SERVER_SSH_PORT: "22"
# Если нужно изменить порт с дефолнтого (WORLD_SERVER_SSH_PORT) на другой - указать нужный
# После смены не обязательно переносить его в WORLD_SERVER_SSH_PORT - при запуске происходит выбор доступного из двух
# Если после смены надо поменять еще раз, тогда нужно перенести значение в WORLD_SERVER_SSH_PORT, а тут указать новое
# По умолчанию при сетапе сервера поменяет на 2922
WORLD_SERVER_NEW_SSH_PORT: "2922"
# Пользователь, под которым ansible авторизуется на сервере. Должен иметь привилегии для входа под root (sudo)
WORLD_SERVER_USER="root"

# password - если авторизация на сервер по паролю (+заполнить WORLD_SERVER_PASSWORD)
# ssh - если авторизация на сервер по ssh-ключу (+заполнить WORLD_SERVER_SSH_FILE_NAME)
WORLD_SERVER_AUTH_METHOD="password"
# Пароль, под которым ansible авторизуется на сервере. Должен иметь привилегии для входа под root (sudo)
# Нужно либо заполнить, либо изменить WORLD_SERVER_AUTH_METHOD
WORLD_SERVER_PASSWORD="<пароль_от_WORLD_SERVER_USER>"
# Если вход на сервер по ssh ключу, положи в папку ssh свой приватный ключ, укажи тут название (только название) файла и поставь WORLD_SERVER_AUTH_METHOD="ssh"
WORLD_SERVER_SSH_FILE_NAME="<название_файла_с_ssh_ключом>"

# Если WORLD_SERVER_USER - не root: поставить WORLD_SERVER_BECOME="1", заполнить WORLD_SERVER_BECOME_PASSWORD
# После входа на сервер под WORLD_SERVER_USER ansible попытается стать WORLD_SERVER_BECOME_USER
WORLD_SERVER_BECOME="0"
WORLD_SERVER_BECOME_USER="root"
# Пароль, запрашиваемый при sudo для пользователя WORLD_SERVER_USER
# Если вход на сервер под пользователем WORLD_SERVER_USER по паролю, то как правило WORLD_SERVER_BECOME_PASSWORD="${WORLD_SERVER_PASSWORD}"
WORLD_SERVER_BECOME_PASSWORD="${WORLD_SERVER_PASSWORD}"

# Токен телеграм-бота для 3x-ui панели, установенной на зарубежном сервере
WORLD_SERVER_3X_TG_BOT_TOKEN: ""
# ID чата (пользователя) админа телеграм-бота для панели, установенной на зарубежном сервере
# Смотрим свой id через @username_to_id_bot
WORLD_SERVER_3X_TG_BOT_CHAT_ID: "0"
# ---

# Пароль для маскировки веб-сервера под basic-авторизацию
# Поставить свой (сложный!)
CADDY_DUMMY_BASIC_PASSWORD=""
# Пароль для входа в панель.
# Поставить свой (сложный!)
# Пользователь - admin
PANEL_PASSWORD=""
