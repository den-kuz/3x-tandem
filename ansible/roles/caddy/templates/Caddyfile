{
    admin off
    https_port 4123
    default_bind 127.0.0.1
    servers {
        protocols h1 h2
        listener_wrappers {
            proxy_protocol {
                allow 127.0.0.1/32
            }
            tls
        }
    }
    auto_https disable_redirects
}

https://{{ DOMAIN }} {
    basic_auth {
        dummy {{ CADDY_BASIC_PASSWORD | string | trim | password_hash('bcrypt') }}
    }

    log {
        output file /logs/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }

    header -Server
    respond "Hello, world!"
}

http://{{ DOMAIN }} {
    bind 0.0.0.0
    header -Server
    redir https://{host}{uri} permanent
}

{% if PANEL_3X_SUBS_PORT is defined %}
https://{{ DOMAIN }}:{{ PANEL_3X_SUBS_PORT }} {
    bind 0.0.0.0
    header -Server
    reverse_proxy localhost:2096
}
{% endif %}

:4123 {
    tls internal
    respond 204
}

:80 {
    bind 0.0.0.0
    respond 204
}
